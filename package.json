{
  "name": "careerx",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CareerX – Campus to Corporate: an AI-powered career readiness platform (hackathon demo build).",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:vite\"",
    "dev:api": "node server/index.js",
    "dev:vite": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "npm run preview",
    "smoke": "sh scripts/smoke.sh",
    "smoke:hi": "SMOKE_LANG=hi sh scripts/smoke.sh",
    "interact": "sh scripts/interact.sh",
    "qa": "sh scripts/smoke.sh && SMOKE_LANG=hi sh scripts/smoke.sh && sh scripts/interact.sh"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "^1.48.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.12",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.21"
  }
}
